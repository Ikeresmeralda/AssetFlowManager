<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        El único permiso que pide la aplicación. No hay acceso a contactos,
        almacenamiento, ubicación ni cámara porque nada de eso hace falta para
        gestionar un inventario: pedir permisos «por si acaso» es una fuga de
        datos personales esperando a ocurrir.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AssetFlow"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            allowBackup="false" es deliberado: la copia de seguridad automática
            de Android sacaría del dispositivo el almacén cifrado con el token
            de sesión. Los ficheros de reglas de abajo son el cinturón sobre
            los tirantes, por si alguien lo reactiva.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AssetFlow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
