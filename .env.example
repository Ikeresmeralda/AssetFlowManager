# =============================================================================
# AssetFlow Manager · plantilla de variables de entorno
# =============================================================================
#
# Copia este archivo a `.env` y rellénalo. `.env` está ignorado por git.
#
#   cp .env.example .env
#
# NINGÚN VALOR REAL DEBE ACABAR EN ESTE ARCHIVO. Es una plantilla versionada.
#
# La API lee la configuración por capas, de menor a mayor prioridad:
#
#   1. appsettings.json            (versionado, sin secretos)
#   2. appsettings.{Entorno}.json  (versionado, sin secretos)
#   3. Secretos de usuario         (sólo en desarrollo, fuera del repositorio)
#   4. Variables de entorno        (este archivo; lo que se usa en producción)
#
# El prefijo `ASSETFLOW_` y el doble guion bajo son la convención de .NET para
# expresar secciones anidadas: `ASSETFLOW_Jwt__Key` equivale a la clave
# `Jwt:Key` del appsettings.
#
# Ver docs/configuration.md para el detalle.
# =============================================================================


# -----------------------------------------------------------------------------
# ENTORNO
# -----------------------------------------------------------------------------
# `Development` genera una clave de firma temporal en cada arranque y siembra
# datos de ejemplo. `Production` no perdona nada: si falta un valor obligatorio,
# la aplicación no llega a levantarse.
ASPNETCORE_ENVIRONMENT=Production

# Direcciones en las que escucha la API. En producción, detrás de un proxy
# inverso que termine TLS.
ASPNETCORE_URLS=http://localhost:5171


# -----------------------------------------------------------------------------
# FIRMA DE TOKENS  (obligatorio en producción)
# -----------------------------------------------------------------------------
# Mínimo 32 caracteres. Genera una aleatoria, nunca la escribas a mano:
#
#   Linux / macOS      openssl rand -base64 48
#   Windows            [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#
# Cambiarla invalida todas las sesiones abiertas.
ASSETFLOW_Jwt__Key=

# Deben coincidir con lo que espera el cliente.
ASSETFLOW_Jwt__Issuer=AssetFlow.Api
ASSETFLOW_Jwt__Audience=AssetFlow.Desktop

# Minutos de vida del token de acceso y días del token de refresco.
ASSETFLOW_Jwt__AccessTokenMinutes=15
ASSETFLOW_Jwt__RefreshTokenDays=7


# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# `Sqlite` (por defecto, no necesita instalar nada) o `SqlServer`.
ASSETFLOW_Database__Provider=Sqlite

# SQLite:
#   Data Source=/ruta/absoluta/assetflow.db
#
# SQL Server (usa una cuenta con permisos mínimos sobre esta base de datos, no
# `sa`; ver docs/configuration.md):
#   Server=SERVIDOR;Database=AssetFlow;User Id=USUARIO;Password=CONTRASENA;Encrypt=True;TrustServerCertificate=False
ASSETFLOW_ConnectionStrings__Default=


# -----------------------------------------------------------------------------
# ADMINISTRADOR INICIAL
# -----------------------------------------------------------------------------
# Si la base de datos está vacía, crea la cuenta admin con esta contraseña. Si
# no se define, en desarrollo se genera una aleatoria y se imprime una única
# vez por consola; en producción la aplicación no arranca sin ella.
#
# También se comprueba en arranques posteriores: si la cuenta admin ya existe
# y esta contraseña no coincide con la que tiene guardada, se actualiza. Sirve
# como mecanismo de recuperación (fijar aquí una contraseña conocida y
# redesplegar), pero también significa que si la dejas puesta, sustituye a
# cualquier contraseña que el administrador haya cambiado desde la aplicación
# en el siguiente arranque. Cámbiala desde la aplicación en cuanto entres, y
# retira esta variable después.
ASSETFLOW_Seed__AdminPassword=


# -----------------------------------------------------------------------------
# CORREO SALIENTE  (recuperación de contraseña)
# -----------------------------------------------------------------------------
# Si `SmtpHost` está vacío, la aplicación NO envía correo: escribe el mensaje
# en el registro. Sirve para desarrollo y para probar el flujo completo sin un
# servidor de correo, pero en producción significa que nadie recibirá su código
# de recuperación.
#
# Con Gmail o similares necesitarás una contraseña de aplicación, no la de tu
# cuenta. Ver docs/configuration.md.
ASSETFLOW_Email__SmtpHost=
ASSETFLOW_Email__SmtpPort=587
ASSETFLOW_Email__UseStartTls=true
ASSETFLOW_Email__Username=
ASSETFLOW_Email__Password=
ASSETFLOW_Email__FromAddress=
ASSETFLOW_Email__FromName=AssetFlow Manager

# Ejemplo con Resend, que es un proveedor transaccional y habla SMTP, así que
# no hace falta ningún código ni paquete adicional. La contraseña es la clave
# de API (empieza por `re_`); créala con permiso de *envío* únicamente.
#
#   ASSETFLOW_Email__SmtpHost=smtp.resend.com
#   ASSETFLOW_Email__SmtpPort=465
#   ASSETFLOW_Email__UseStartTls=false
#   ASSETFLOW_Email__Username=resend
#   ASSETFLOW_Email__Password=re_TU_CLAVE_DE_API
#   ASSETFLOW_Email__FromAddress=no-reply@tu-dominio-verificado.com
#   ASSETFLOW_Email__FromName=AssetFlow Manager


# -----------------------------------------------------------------------------
# PROXY INVERSO
# -----------------------------------------------------------------------------
# Sólo si la API va detrás de nginx, Apache o IIS. Declara aquí la dirección de
# cada proxy; sin esto, ASP.NET Core descarta las cabeceras X-Forwarded-* y la
# API ve todas las peticiones con la IP del proxy, lo que deja el limitador del
# acceso repartiendo por una única partición. Ver docs/configuration.md.
#
#   ASSETFLOW_ForwardedHeaders__KnownProxies__0=10.0.0.5
#   ASSETFLOW_ForwardedHeaders__KnownProxies__1=10.0.0.6
