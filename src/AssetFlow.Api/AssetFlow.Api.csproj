<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetFlow.Api</RootNamespace>
    <AssemblyName>AssetFlow.Api</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Identificador del almacen de secretos de usuario. No es un secreto:
         es solo el nombre de la carpeta, fuera del repositorio, donde .NET
         guarda las credenciales de desarrollo (clave de firma, contrasena
         SMTP). Ver docs/configuration.md. -->
    <UserSecretsId>inventario-api-8f3c1d90</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Los comentarios XML alimentan Swagger. No exigimos documentar
         absolutamente todo, asi que se silencia el aviso de miembro sin
         comentario; el resto de avisos siguen activos. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- Referencia directa solo para elevar la version.
         EF Core 8.0.11 arrastra SQLitePCLRaw 2.1.6, que tiene una
         vulnerabilidad de gravedad alta (GHSA-2m69-gcr7-jv3q) en la biblioteca
         nativa de SQLite. Declararlo aqui gana a la version transitiva.
         Se comprueba con "dotnet list package" y el modificador de paquetes
         vulnerables, incluyendo los transitivos. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AssetFlow.Api.Tests" />
  </ItemGroup>

</Project>
