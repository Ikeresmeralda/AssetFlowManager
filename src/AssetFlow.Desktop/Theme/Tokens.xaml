<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        TOKENS DE DISENO
        ================
        Punto unico donde vive la identidad visual. Cambiar un color aqui lo
        cambia en toda la aplicacion. La version anterior tenia 101 fuentes y
        8 colores repartidos por 200 KB de codigo autogenerado.

        Criterios:
          - Fondo gris muy claro, no blanco puro: es una herramienta que se
            usa durante horas y el blanco puro cansa la vista.
          - Un unico azul de accion. Antes habia tres azules distintos
            haciendo el mismo papel.
          - Navegacion oscura, contenido claro: separa el chrome del dato y
            es lo que hace que se lea como producto y no como formulario.
          - Bordes de 1 px en lugar de sombras. Las sombras se reservan para
            lo que realmente flota (menus, dialogos).
    -->

    <!-- ============ SUPERFICIES ============ -->
    <Color x:Key="Clr.Canvas">#F6F7F9</Color>
    <Color x:Key="Clr.Surface">#FFFFFF</Color>
    <Color x:Key="Clr.SurfaceAlt">#FAFBFC</Color>
    <Color x:Key="Clr.SurfaceHover">#F1F3F6</Color>
    <Color x:Key="Clr.SurfaceSunken">#EDEFF3</Color>

    <SolidColorBrush x:Key="Canvas" Color="{StaticResource Clr.Canvas}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource Clr.Surface}"/>
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource Clr.SurfaceAlt}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource Clr.SurfaceHover}"/>
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource Clr.SurfaceSunken}"/>

    <!-- ============ NAVEGACION (oscura) ============ -->
    <Color x:Key="Clr.Nav">#171B22</Color>
    <Color x:Key="Clr.NavAlt">#1E232C</Color>
    <Color x:Key="Clr.NavHover">#262D38</Color>
    <Color x:Key="Clr.NavActive">#2D3644</Color>
    <Color x:Key="Clr.NavText">#C3CAD6</Color>
    <Color x:Key="Clr.NavTextMuted">#78828F</Color>

    <SolidColorBrush x:Key="Nav" Color="{StaticResource Clr.Nav}"/>
    <SolidColorBrush x:Key="NavAlt" Color="{StaticResource Clr.NavAlt}"/>
    <SolidColorBrush x:Key="NavHover" Color="{StaticResource Clr.NavHover}"/>
    <SolidColorBrush x:Key="NavActive" Color="{StaticResource Clr.NavActive}"/>
    <SolidColorBrush x:Key="NavText" Color="{StaticResource Clr.NavText}"/>
    <SolidColorBrush x:Key="NavTextMuted" Color="{StaticResource Clr.NavTextMuted}"/>

    <!-- ============ BORDES ============ -->
    <Color x:Key="Clr.Border">#E2E5EA</Color>
    <Color x:Key="Clr.BorderStrong">#CDD2DA</Color>
    <Color x:Key="Clr.BorderFocus">#1F5FD6</Color>

    <SolidColorBrush x:Key="Border" Color="{StaticResource Clr.Border}"/>
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource Clr.BorderStrong}"/>
    <SolidColorBrush x:Key="BorderFocus" Color="{StaticResource Clr.BorderFocus}"/>

    <!-- ============ TEXTO ============
         Contraste sobre Surface (#FFFFFF):
           Text        #14171C  →  15.8:1   (AAA)
           TextMuted   #59626F  →   6.5:1   (AA / AAA texto grande)
           TextSubtle  #7A8391  →   4.1:1   (AA solo texto grande o secundario)
    -->
    <Color x:Key="Clr.Text">#14171C</Color>
    <Color x:Key="Clr.TextMuted">#59626F</Color>
    <Color x:Key="Clr.TextSubtle">#7A8391</Color>
    <Color x:Key="Clr.TextDisabled">#A8AFB9</Color>
    <Color x:Key="Clr.TextOnAccent">#FFFFFF</Color>

    <SolidColorBrush x:Key="Text" Color="{StaticResource Clr.Text}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource Clr.TextMuted}"/>
    <SolidColorBrush x:Key="TextSubtle" Color="{StaticResource Clr.TextSubtle}"/>
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource Clr.TextDisabled}"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="{StaticResource Clr.TextOnAccent}"/>

    <!-- ============ ACCION ============
         #1F5FD6 sobre blanco = 5.9:1 (AA). Sobre el se usa texto blanco: 4.9:1.
    -->
    <Color x:Key="Clr.Accent">#1F5FD6</Color>
    <Color x:Key="Clr.AccentHover">#1A52BC</Color>
    <Color x:Key="Clr.AccentPressed">#154599</Color>
    <Color x:Key="Clr.AccentSoft">#EBF1FC</Color>
    <Color x:Key="Clr.AccentSoftBorder">#C5D8F7</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource Clr.Accent}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource Clr.AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource Clr.AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource Clr.AccentSoft}"/>
    <SolidColorBrush x:Key="AccentSoftBorder" Color="{StaticResource Clr.AccentSoftBorder}"/>

    <!-- ============ SEMANTICOS ============
         Cada estado tiene un tono fuerte (texto/icono) y uno suave (fondo).
         Nunca se usa solo el color para transmitir informacion: siempre
         acompanado de texto o icono (requisito de accesibilidad).
    -->
    <Color x:Key="Clr.Success">#15734A</Color>
    <Color x:Key="Clr.SuccessSoft">#E6F4EC</Color>
    <Color x:Key="Clr.SuccessBorder">#B4DEC7</Color>

    <Color x:Key="Clr.Warning">#8A5A00</Color>
    <Color x:Key="Clr.WarningSoft">#FDF3E0</Color>
    <Color x:Key="Clr.WarningBorder">#F0D9A8</Color>

    <Color x:Key="Clr.Danger">#B3271E</Color>
    <Color x:Key="Clr.DangerHover">#98201A</Color>
    <Color x:Key="Clr.DangerSoft">#FCECEA</Color>
    <Color x:Key="Clr.DangerBorder">#F2C4BF</Color>

    <SolidColorBrush x:Key="Success" Color="{StaticResource Clr.Success}"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource Clr.SuccessSoft}"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="{StaticResource Clr.SuccessBorder}"/>
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Clr.Warning}"/>
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource Clr.WarningSoft}"/>
    <SolidColorBrush x:Key="WarningBorder" Color="{StaticResource Clr.WarningBorder}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Clr.Danger}"/>
    <SolidColorBrush x:Key="DangerHover" Color="{StaticResource Clr.DangerHover}"/>
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource Clr.DangerSoft}"/>
    <SolidColorBrush x:Key="DangerBorder" Color="{StaticResource Clr.DangerBorder}"/>

    <!-- ============ TIPOGRAFIA ============
         Segoe UI Variable en Windows 11, Segoe UI como alternativa.
         No se embeben fuentes: se usa la del sistema, que ya esta optimizada
         para pantalla y respeta la configuracion del usuario.
    -->
    <FontFamily x:Key="FontUI">Segoe UI Variable Text, Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Escala tipografica: 11 / 12 / 13 / 14 / 16 / 20 / 26
         Salto suficiente entre niveles para que la jerarquia se lea sin
         depender del peso. -->
    <sys:Double x:Key="Size.Micro">11</sys:Double>
    <sys:Double x:Key="Size.Caption">12</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.BodyLarge">14</sys:Double>
    <sys:Double x:Key="Size.Subtitle">16</sys:Double>
    <sys:Double x:Key="Size.Title">20</sys:Double>
    <sys:Double x:Key="Size.Display">26</sys:Double>

    <!-- ============ ESPACIADO (escala de 4) ============ -->
    <Thickness x:Key="Pad.Xs">4</Thickness>
    <Thickness x:Key="Pad.Sm">8</Thickness>
    <Thickness x:Key="Pad.Md">12</Thickness>
    <Thickness x:Key="Pad.Lg">16</Thickness>
    <Thickness x:Key="Pad.Xl">24</Thickness>
    <Thickness x:Key="Pad.Field">10,7,10,7</Thickness>
    <Thickness x:Key="Pad.Button">16,0,16,0</Thickness>
    <Thickness x:Key="Pad.Page">24</Thickness>

    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <sys:Double x:Key="Space.Xxl">32</sys:Double>

    <!-- ============ MEDIDAS ============
         Altura unica de control (32) para que inputs y botones se alineen
         sin ajustes manuales. Era uno de los defectos mas visibles antes.
    -->
    <sys:Double x:Key="Ctl.Height">32</sys:Double>
    <sys:Double x:Key="Ctl.HeightLarge">38</sys:Double>
    <sys:Double x:Key="Ctl.HeightSmall">26</sys:Double>
    <sys:Double x:Key="Row.Height">38</sys:Double>
    <sys:Double x:Key="Nav.Width">232</sys:Double>
    <sys:Double x:Key="Header.Height">56</sys:Double>
    <sys:Double x:Key="Status.Height">28</sys:Double>

    <!-- Radios contenidos: 4 en controles, 6 en superficies. Redondear mas
         hace que una herramienta de gestion parezca una aplicacion movil. -->
    <CornerRadius x:Key="Radius.Sm">3</CornerRadius>
    <CornerRadius x:Key="Radius.Md">4</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Duraciones: por debajo de 150 ms se percibe como respuesta inmediata,
         no como animacion. Es el efecto que buscamos. -->
    <Duration x:Key="Dur.Fast">0:0:0.09</Duration>
    <Duration x:Key="Dur.Base">0:0:0.14</Duration>

</ResourceDictionary>
