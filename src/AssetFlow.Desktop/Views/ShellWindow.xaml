<Window x:Class="AssetFlow.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AssetFlow Manager"
        Icon="/Assets/app.ico"
        Height="760" Width="1240"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        ESTRUCTURA
        ==========
        Navegacion fija a la izquierda, contenido a la derecha, barra de estado
        abajo. Todo con Grid: se adapta solo al redimensionar, a diferencia de
        la version anterior, donde cada control tenia una posicion fija y al
        cambiar el tamano de la ventana se cortaban.

        Se conserva la barra de titulo del sistema a proposito: la version
        anterior la dibujaba a mano y con ello perdia Aero Snap, el doble clic
        para maximizar y el redimensionado desde los bordes.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColNav" Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== NAVEGACION ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Nav}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Marca -->
                <Grid Grid.Row="0" Height="60" Margin="20,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{StaticResource Accent}">
                            <TextBlock Text="{StaticResource Ico.Inventory}"
                                       Style="{StaticResource Icon}"
                                       Foreground="White" FontSize="14"/>
                        </Border>
                        <TextBlock Text="AssetFlow Manager" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- Secciones -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <!-- No hay seccion "Inicio". La tenia, pero mostraba la misma
                         pagina de Inventario con otro nombre marcado en el menu.
                         Un panel de inicio propio solo repetiria las cifras de
                         resumen que ya estan sobre la tabla, asi que la pantalla
                         de entrada es directamente el inventario. -->
                    <RadioButton x:Name="NavInventario" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource Ico.Inventory}"
                                 GroupName="Nav" IsChecked="True"
                                 Content="Inventario"
                                 Checked="AlCambiarSeccion"/>

                    <RadioButton x:Name="NavPrestamos" Style="{StaticResource NavItem}"
                                 Tag="{StaticResource Ico.Loans}"
                                 GroupName="Nav"
                                 Content="Préstamos"
                                 Checked="AlCambiarSeccion"/>

                    <!-- Solo visible para administradores -->
                    <StackPanel x:Name="GrupoAdmin" Visibility="Collapsed">
                        <TextBlock Text="ADMINISTRACIÓN" Style="{StaticResource NavGroupLabel}"/>

                        <RadioButton x:Name="NavUsuarios" Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Ico.Users}"
                                     GroupName="Nav"
                                     Content="Usuarios"
                                     Checked="AlCambiarSeccion"/>

                        <!-- El contador va superpuesto al elemento del menú: es
                             el aviso de que hay alguien esperando a que le
                             devuelvan el acceso a su cuenta. -->
                        <Grid>
                            <RadioButton x:Name="NavSolicitudes" Style="{StaticResource NavItem}"
                                         Tag="{StaticResource Ico.Key}"
                                         GroupName="Nav"
                                         Content="Solicitudes"
                                         Checked="AlCambiarSeccion"/>

                            <Border x:Name="AvisoPendientes"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,18,0"
                                    MinWidth="20" Height="20" CornerRadius="10"
                                    Background="{StaticResource Danger}"
                                    IsHitTestVisible="False">
                                <TextBlock x:Name="TxtPendientes" Text="0"
                                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="6,0,6,0"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Pie: usuario y sesion -->
                <StackPanel Grid.Row="2" Margin="8,0,8,10">
                    <Border Height="1" Background="#2A313B" Margin="12,0,12,10"/>

                    <Grid Margin="12,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30" CornerRadius="15"
                                Background="{StaticResource NavActive}">
                            <TextBlock x:Name="TxtIniciales" Text="?"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNombreUsuario" Text="—"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="13" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtRolUsuario" Text=""
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="11"
                                       Foreground="{StaticResource NavTextMuted}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnCerrarSesion" Style="{StaticResource NavAction}"
                            Click="AlCerrarSesion">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Ico.SignOut}"
                                       Style="{StaticResource Icon.Small}" Margin="0,0,10,0"/>
                            <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== AREA DE TRABAJO ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Border Grid.Row="0" Height="56" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTituloSeccion" Text="Inicio"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="TxtSubtituloSeccion" Text=""
                                   Style="{StaticResource T.Caption}"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Indicador de conexion: en una aplicacion que depende de un
                         servidor, saber si hay conexion debe ser visible siempre,
                         no descubrirse al fallar una operacion. -->
                    <Border x:Name="ChipConexion" Grid.Column="1"
                            Style="{StaticResource Badge.Success}"
                            VerticalAlignment="Center" Padding="9,4,10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="IcoConexion" Text="{StaticResource Ico.Online}"
                                       Style="{StaticResource Icon.Small}" FontSize="11"
                                       Foreground="{StaticResource Success}"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtConexion" Text="Conectado"
                                       Style="{StaticResource Badge.Text}"
                                       Foreground="{StaticResource Success}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Contenido intercambiable -->
            <ContentControl x:Name="Contenido" Grid.Row="1"/>

            <!-- Barra de estado -->
            <Border Grid.Row="2" Height="28" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="24,0,20,0">
                    <TextBlock x:Name="TxtEstado" Text="Listo"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="11"
                               Foreground="{StaticResource TextSubtle}"/>
                    <TextBlock x:Name="TxtVersion" Text="v1.0.0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="11"
                               Foreground="{StaticResource TextSubtle}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
