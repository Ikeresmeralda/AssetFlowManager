<UserControl x:Class="AssetFlow.Desktop.Views.PrestamosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AssetFlow.Desktop.Controls"
             Background="{StaticResource Canvas}">

    <!--
        PRÉSTAMOS
        =========
        Misma estructura que Inventario para que la aplicación se lea como una
        sola cosa: barra de herramientas, resumen, tabla y pie.

        Un usuario normal ve aquí solo sus préstamos. No es una decisión de
        esta pantalla: la API devuelve únicamente los suyos, ignore lo que
        ignore el cliente.
    -->

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== BARRA DE HERRAMIENTAS ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="TxtBuscar"
                         Tag="Buscar por persona o artículo…"
                         Padding="32,7,30,7"
                         AutomationProperties.Name="Buscar préstamos"
                         TextChanged="AlEscribirBusqueda"
                         KeyDown="AlPulsarTeclaEnBusqueda"/>
                <TextBlock Text="{StaticResource Ico.Search}"
                           Style="{StaticResource Icon.Small}"
                           HorizontalAlignment="Left" Margin="10,0,0,0"
                           Foreground="{StaticResource TextSubtle}"
                           IsHitTestVisible="False"/>
                <Button x:Name="BtnLimpiar" Visibility="Collapsed"
                        HorizontalAlignment="Right" Margin="0,0,4,0"
                        Width="24" Height="24" Padding="0"
                        Style="{StaticResource Btn.Ghost}"
                        ToolTip="Limpiar búsqueda (Esc)"
                        AutomationProperties.Name="Limpiar búsqueda"
                        Click="AlLimpiarBusqueda">
                    <TextBlock Text="{StaticResource Ico.Close}" FontSize="10"
                               Style="{StaticResource Icon.Small}"/>
                </Button>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <!--
                    Las opciones las rellena el código: un administrador tiene
                    dos filtros más («Pendientes de aprobar» y «Devoluciones
                    pendientes») que a un usuario normal no le corresponden.
                -->
                <ComboBox x:Name="CmbEstado" Width="196" Height="32"
                          VerticalContentAlignment="Center"
                          FontFamily="{StaticResource FontUI}"
                          FontSize="13"
                          AutomationProperties.Name="Filtrar por estado del préstamo"
                          SelectionChanged="AlCambiarFiltro"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="BtnRefrescar" Style="{StaticResource Btn.Ghost}"
                        Width="32" Padding="0" ToolTip="Actualizar (F5)"
                        AutomationProperties.Name="Actualizar préstamos"
                        Click="AlRefrescar">
                    <TextBlock Text="{StaticResource Ico.Refresh}" Style="{StaticResource Icon.Small}"/>
                </Button>

                <Button x:Name="BtnNuevo" Style="{StaticResource Btn.Primary}"
                        Margin="8,0,0,0" ToolTip="Nuevo préstamo (Ctrl+N)"
                        Click="AlCrear">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Ico.Add}"
                                   Style="{StaticResource Icon.Small}" Margin="0,0,7,0"/>
                        <TextBlock Text="Nuevo préstamo" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== RESUMEN ====================
             Cada cifra es un botón que aplica su propio filtro. Antes eran
             sólo texto, así que la pantalla informaba de que había cuatro
             solicitudes pendientes pero obligaba a ir a buscarlas al
             desplegable. Lo que llama la atención debe poder pulsarse.
        -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"
                Padding="8,6,8,6">
            <StackPanel Orientation="Horizontal">

                <Button x:Name="BtnResumenPendientes" Style="{StaticResource Stat.Tile}"
                        Visibility="Collapsed" Click="AlFiltrarPendientes">
                    <StackPanel>
                        <TextBlock x:Name="TxtEtiquetaPendientes" Text="PENDIENTES"
                                   Style="{StaticResource T.SectionHeader}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtPendientes" Text="—" Style="{StaticResource Stat.Value}"/>
                    </StackPanel>
                </Button>

                <Border x:Name="SepPendientes" Style="{StaticResource Stat.Separator}"
                        Visibility="Collapsed"/>

                <Button Style="{StaticResource Stat.Tile}" Click="AlFiltrarEnCurso">
                    <StackPanel>
                        <TextBlock Text="EN CURSO" Style="{StaticResource T.SectionHeader}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtEnCurso" Text="—" Style="{StaticResource Stat.Value}"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Stat.Separator}"/>

                <Button Style="{StaticResource Stat.Tile}" Click="AlVerVencidos">
                    <StackPanel>
                        <TextBlock Text="VENCIDOS" Style="{StaticResource T.SectionHeader}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtVencidos" Text="—" Style="{StaticResource Stat.Value}"/>
                    </StackPanel>
                </Button>

                <Border x:Name="SepDevoluciones" Style="{StaticResource Stat.Separator}"
                        Visibility="Collapsed"/>

                <Button x:Name="BtnResumenDevoluciones" Style="{StaticResource Stat.Tile}"
                        Visibility="Collapsed" Click="AlFiltrarDevoluciones">
                    <StackPanel>
                        <TextBlock Text="DEVOLUCIONES" Style="{StaticResource T.SectionHeader}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtDevoluciones" Text="—" Style="{StaticResource Stat.Value}"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Stat.Separator}"/>

                <Button Style="{StaticResource Stat.Tile}" IsHitTestVisible="False" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="UNIDADES FUERA" Style="{StaticResource T.SectionHeader}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtUnidades" Text="—" Style="{StaticResource Stat.Value}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== TABLA ==================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="Tabla" Grid.Row="0"
                          Style="{StaticResource Grid.Table}"
                          SelectionChanged="AlSeleccionarFila"
                          MouseDoubleClick="AlDobleClic">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Id}" Width="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn x:Name="ColPersona" Header="PERSONA"
                                            Binding="{Binding UserFullName}" Width="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MATERIAL" Binding="{Binding ResumenArticulos}" Width="*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="MOTIVO" Binding="{Binding Reason}" Width="*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Una solicitud sin aprobar todavía no tiene fecha de
                             entrega. Se muestra un guion y no una casilla en
                             blanco, que se lee como un fallo de carga. -->
                        <DataGridTextColumn Header="PRESTADO" Width="96"
                                            Binding="{Binding LoanDate, StringFormat=dd/MM/yyyy,
                                                      TargetNullValue=—}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DEVOLUCIÓN" Width="104"
                                            Binding="{Binding EstimatedReturnDate, StringFormat=dd/MM/yyyy}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                </Style>
                                <!-- La fecha vencida se marca en el propio dato,
                                     no solo con el distintivo de estado. -->
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!--
                            ESTADO
                            ======
                            Tres señales independientes, en este orden de
                            importancia: el texto («Pendiente»), el símbolo
                            (reloj, marca, aspa…) y sólo al final el color.
                            Quien no distingue verde de rojo, o mira la pantalla
                            en blanco y negro, sigue leyendo el estado sin
                            perder nada.

                            Debajo va una línea que dice qué se espera a
                            continuación: «Pendiente» a secas no aclara si hay
                            que hacer algo o esperar.
                        -->
                        <DataGridTemplateColumn Header="ESTADO" Width="188">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4,0,4">
                                        <Border x:Name="chip" Style="{StaticResource Badge.Neutral}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ico"
                                                           Text="{StaticResource Ico.Info}"
                                                           Style="{StaticResource Badge.Glyph}"
                                                           Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="txt" Text="{Binding EstadoTexto}"
                                                           Style="{StaticResource Badge.Text}"
                                                           Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding EstadoDetalle}"
                                                   Style="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding EstadoDetalle}"
                                                   Margin="1,3,0,0"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Pendiente">
                                            <Setter TargetName="chip" Property="Style"
                                                    Value="{StaticResource Badge.Warning}"/>
                                            <Setter TargetName="txt" Property="Foreground"
                                                    Value="{StaticResource Warning}"/>
                                            <Setter TargetName="ico" Property="Foreground"
                                                    Value="{StaticResource Warning}"/>
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.Pending}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="En curso">
                                            <Setter TargetName="chip" Property="Style"
                                                    Value="{StaticResource Badge.Success}"/>
                                            <Setter TargetName="txt" Property="Foreground"
                                                    Value="{StaticResource Success}"/>
                                            <Setter TargetName="ico" Property="Foreground"
                                                    Value="{StaticResource Success}"/>
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.Approved}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Vencido">
                                            <Setter TargetName="chip" Property="Style"
                                                    Value="{StaticResource Badge.Danger}"/>
                                            <Setter TargetName="txt" Property="Foreground"
                                                    Value="{StaticResource Danger}"/>
                                            <Setter TargetName="ico" Property="Foreground"
                                                    Value="{StaticResource Danger}"/>
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.Overdue}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Rechazada">
                                            <Setter TargetName="chip" Property="Style"
                                                    Value="{StaticResource Badge.Danger}"/>
                                            <Setter TargetName="txt" Property="Foreground"
                                                    Value="{StaticResource Danger}"/>
                                            <Setter TargetName="ico" Property="Foreground"
                                                    Value="{StaticResource Danger}"/>
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.Rejected}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Devolución pendiente">
                                            <Setter TargetName="chip" Property="Style"
                                                    Value="{StaticResource Badge.Info}"/>
                                            <Setter TargetName="txt" Property="Foreground"
                                                    Value="{StaticResource Accent}"/>
                                            <Setter TargetName="ico" Property="Foreground"
                                                    Value="{StaticResource Accent}"/>
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.ReturnPending}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="Devuelto">
                                            <Setter TargetName="ico" Property="Text"
                                                    Value="{StaticResource Ico.Returned}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            ACCIONES
                            ========
                            Qué botones aparecen lo decide FilaPrestamo, no un
                            enredo de DataTrigger: depende a la vez del estado
                            y del rol.

                            Las acciones destructivas o irreversibles (rechazar,
                            eliminar) se mantienen visualmente separadas de las
                            de confirmación para que no se pulsen por inercia.
                        -->
                        <DataGridTemplateColumn Header="ACCIONES" Width="228">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Height="26" Padding="8,0,8,0" FontSize="12"
                                                Foreground="{StaticResource Success}"
                                                Content="Aprobar"
                                                Visibility="{Binding VerDecision}"
                                                ToolTip="Aprobar la solicitud y entregar el material"
                                                Click="AlAprobarFila"/>

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Height="26" Padding="8,0,8,0" FontSize="12"
                                                Margin="2,0,0,0"
                                                Foreground="{StaticResource Danger}"
                                                Content="Rechazar"
                                                Visibility="{Binding VerDecision}"
                                                ToolTip="Rechazar la solicitud"
                                                Click="AlRechazarFila"/>

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Height="26" Padding="8,0,8,0" FontSize="12"
                                                Foreground="{StaticResource Success}"
                                                Content="Confirmar"
                                                Visibility="{Binding VerDecisionDevolucion}"
                                                ToolTip="Confirmar que el material ha vuelto"
                                                Click="AlConfirmarDevolucionFila"/>

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Height="26" Padding="8,0,8,0" FontSize="12"
                                                Margin="2,0,0,0"
                                                Foreground="{StaticResource Danger}"
                                                Content="No ha vuelto"
                                                Visibility="{Binding VerDecisionDevolucion}"
                                                ToolTip="El material no ha vuelto: el préstamo sigue activo"
                                                Click="AlRechazarDevolucionFila"/>

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Height="26" Padding="8,0,8,0" FontSize="12"
                                                Foreground="{StaticResource Accent}"
                                                Content="{Binding TextoDevolver}"
                                                Visibility="{Binding VerDevolver}"
                                                ToolTip="F2"
                                                Click="AlDevolverFila"/>

                                        <Button Style="{StaticResource Btn.Ghost}"
                                                Width="28" Height="26" Padding="0"
                                                Margin="4,0,0,0"
                                                ToolTip="Eliminar del historial"
                                                AutomationProperties.Name="Eliminar préstamo"
                                                Visibility="{Binding VerEliminar}"
                                                Click="AlEliminarFila">
                                            <TextBlock Text="{StaticResource Ico.Delete}"
                                                       Style="{StaticResource Icon.Small}"
                                                       Foreground="{StaticResource Danger}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <c:EstadoPanel x:Name="Estado" Grid.Row="0" Margin="0,40,0,0"/>

                <Border Grid.Row="1" Height="36" Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,0,16,0">
                        <TextBlock x:Name="TxtRecuento" Text=""
                                   VerticalAlignment="Center"
                                   Style="{StaticResource T.Caption}"/>
                        <TextBlock x:Name="TxtAyuda"
                                   Text="Doble clic para ver el detalle  ·  Ctrl+N nuevo"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource T.Caption}"
                                   Foreground="{StaticResource TextSubtle}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>