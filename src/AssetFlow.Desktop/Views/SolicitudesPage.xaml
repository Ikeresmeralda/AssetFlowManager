<UserControl x:Class="AssetFlow.Desktop.Views.SolicitudesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <!--
        SOLICITUDES DE RECUPERACIÓN DE CONTRASEÑA
        =========================================
        Bandeja del administrador. Sustituye al código por correo: quien olvida
        su contraseña deja una solicitud aquí y una persona la autoriza.

        Lo que esta pantalla NO muestra, y es deliberado: el correo de la
        cuenta. Está en la ficha del usuario para quien lo necesite, y ponerlo
        aquí lo dejaría a la vista en una pantalla que se queda abierta.

        Aprobar entrega el acceso a una cuenta. La responsabilidad de comprobar
        por otra vía que quien pide el cambio es quien dice ser es de quien
        aprueba, y por eso el texto de la ventana de confirmación lo recuerda.
    -->

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== BARRA SUPERIOR ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <CheckBox x:Name="ChkSoloPendientes" Content="Sólo pendientes"
                          IsChecked="True" VerticalAlignment="Center"
                          Checked="AlCambiarFiltro" Unchecked="AlCambiarFiltro"/>
            </StackPanel>

            <Button x:Name="BtnRecargar" Content="Actualizar"
                    HorizontalAlignment="Right" MinWidth="110"
                    Style="{StaticResource Btn.Secondary}"
                    Click="AlRecargar"/>
        </Grid>

        <!-- ==================== AVISO ==================== -->
        <Border Grid.Row="1" x:Name="PanelAviso"
                Style="{StaticResource Badge.Info}"
                Visibility="Collapsed" Margin="0,0,0,14"
                HorizontalAlignment="Stretch" Padding="14,11,14,11">
            <TextBlock x:Name="TxtAviso" Text=""
                       Style="{StaticResource T.Caption}"
                       Foreground="{StaticResource Accent}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ==================== LISTA ==================== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Md}">
            <Grid>
                <DataGrid x:Name="Tabla"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          AutomationProperties.Name="Solicitudes de recuperación de contraseña">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Width="160"
                                            Binding="{Binding Username}"/>
                        <DataGridTextColumn Header="Nombre" Width="*"
                                            Binding="{Binding FullName}"/>
                        <DataGridTextColumn Header="Solicitada" Width="150"
                                            Binding="{Binding SolicitadaTexto}"/>
                        <DataGridTextColumn Header="Estado" Width="110"
                                            Binding="{Binding Estado}"/>
                        <DataGridTextColumn Header="Resuelta por" Width="140"
                                            Binding="{Binding ResolvedByUsername}"/>

                        <DataGridTemplateColumn Header="" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding VerAcciones}">
                                        <Button Content="Aprobar"
                                                MinWidth="86" Margin="0,0,6,0"
                                                Style="{StaticResource Btn.Primary}"
                                                Tag="{Binding Id}"
                                                Click="AlAprobar"/>
                                        <Button Content="Denegar"
                                                MinWidth="86"
                                                Style="{StaticResource Btn.Secondary}"
                                                Tag="{Binding Id}"
                                                Click="AlDenegar"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Estado vacío -->
                <TextBlock x:Name="TxtVacio"
                           Text="No hay ninguna solicitud pendiente."
                           Style="{StaticResource T.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
