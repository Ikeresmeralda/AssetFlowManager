<Window x:Class="AssetFlow.Desktop.Dialogs.PrestamoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo préstamo"
        Height="640" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        NUEVO PRÉSTAMO
        ==============
        Dos mitades: a la izquierda el catálogo del que se elige, a la derecha
        lo que se lleva. Es el patrón de un carrito, y funciona porque prestar
        material es exactamente eso.

        La disponibilidad se muestra en el propio catálogo: elegir un artículo
        agotado y descubrirlo al guardar sería hacer perder el tiempo.
    -->

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="Titulo" Text="Nuevo préstamo" Style="{StaticResource T.Title}"/>
            <TextBlock Text="Elige el material y quién se lo lleva."
                       Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- DATOS DEL PRÉSTAMO -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblPersona"
                       Text="Se lo lleva" Style="{StaticResource T.Label}" Margin="0,0,0,5"/>
            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CmbUsuario"
                      Height="32" VerticalContentAlignment="Center"
                      FontFamily="{StaticResource FontUI}" FontSize="13"
                      DisplayMemberPath="FullName"
                      AutomationProperties.LabeledBy="{Binding ElementName=LblPersona}"/>

            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblFecha"
                       Text="Devolución prevista" Style="{StaticResource T.Label}" Margin="0,0,0,5"/>
            <DatePicker Grid.Row="1" Grid.Column="2" x:Name="FechaDevolucion"
                        Height="32" VerticalContentAlignment="Center"
                        FontFamily="{StaticResource FontUI}" FontSize="13"
                        AutomationProperties.LabeledBy="{Binding ElementName=LblFecha}"
                        SelectedDateChanged="AlCambiarFecha"/>

            <TextBlock Grid.Row="0" Grid.Column="4" x:Name="LblMotivo"
                       Text="Motivo (opcional)" Style="{StaticResource T.Label}" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Grid.Column="4" x:Name="TxtMotivo"
                     Height="32" MaxLength="255"
                     Tag="Fiesta mayor, taller, ensayo…"
                     AutomationProperties.LabeledBy="{Binding ElementName=LblMotivo}"/>

            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ErrFecha"
                       Style="{StaticResource T.Caption}"
                       Foreground="{StaticResource Danger}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- CATÁLOGO Y SELECCIÓN -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Catálogo -->
            <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,12,12,10">
                        <TextBox x:Name="TxtBuscar" Padding="30,6,10,6"
                                 Tag="Buscar material…"
                                 AutomationProperties.Name="Buscar material disponible"
                                 TextChanged="AlBuscar"/>
                        <TextBlock Text="{StaticResource Ico.Search}"
                                   Style="{StaticResource Icon.Small}"
                                   HorizontalAlignment="Left" Margin="9,0,0,0"
                                   Foreground="{StaticResource TextSubtle}"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="ListaCatalogo"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Material disponible"
                             MouseDoubleClick="AlAnadirDesdeCatalogo">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,7,12,7"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Type}"
                                                   Style="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource TextSubtle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               Text="{Binding AvailableQuantity, StringFormat={}{0} libres}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Selección -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                            Padding="12,9,12,9">
                        <TextBlock x:Name="TxtCabeceraSeleccion" Text="MATERIAL DEL PRÉSTAMO"
                                   Style="{StaticResource T.SectionHeader}"/>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="ListaSeleccion"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Material seleccionado">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6,8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource T.Caption}"
                                                   Foreground="{StaticResource TextSubtle}"
                                                   Text="{Binding Disponibles, StringFormat={}máximo {0}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="−" Width="24" Height="24" Padding="0"
                                                Style="{StaticResource Btn.Ghost}"
                                                FontSize="15"
                                                AutomationProperties.Name="Quitar una unidad"
                                                Click="AlRestarUnidad"/>
                                        <TextBlock Text="{Binding Cantidad}"
                                                   Width="30" TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"/>
                                        <Button Content="+" Width="24" Height="24" Padding="0"
                                                Style="{StaticResource Btn.Ghost}"
                                                FontSize="14"
                                                AutomationProperties.Name="Añadir una unidad"
                                                Click="AlSumarUnidad"/>
                                        <Button Width="24" Height="24" Padding="0"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource Btn.Ghost}"
                                                ToolTip="Quitar del préstamo"
                                                AutomationProperties.Name="Quitar del préstamo"
                                                Click="AlQuitarLinea">
                                            <TextBlock Text="{StaticResource Ico.Close}" FontSize="10"
                                                       Style="{StaticResource Icon.Small}"
                                                       Foreground="{StaticResource Danger}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado vacío del carrito: explica qué hacer, no solo que está vacío. -->
                    <StackPanel x:Name="PanelSeleccionVacia" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="220">
                        <TextBlock Text="{StaticResource Ico.Empty}"
                                   Style="{StaticResource Icon.Large}"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDisabled}"/>
                        <TextBlock Text="Sin material todavía"
                                   Style="{StaticResource T.Body}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Haz doble clic en un artículo de la izquierda para añadirlo."
                                   Style="{StaticResource T.Muted}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                            Padding="12,8,12,8">
                        <TextBlock x:Name="TxtTotalUnidades" Text="0 unidades"
                                   Style="{StaticResource T.Caption}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ERROR GENERAL -->
        <Border Grid.Row="3" x:Name="PanelError" Style="{StaticResource Badge.Danger}"
                Visibility="Collapsed" Margin="0,14,0,0"
                HorizontalAlignment="Stretch" Padding="12,9,12,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{StaticResource Ico.Error}"
                           Style="{StaticResource Icon.Small}" FontSize="12"
                           Foreground="{StaticResource Danger}"
                           Margin="0,0,9,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtError" Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- BOTONES -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource Btn.Secondary}"
                    Height="34" MinWidth="100" IsCancel="True"
                    Click="AlCancelar"/>
            <Button x:Name="BtnGuardar" Content="Registrar préstamo"
                    Style="{StaticResource Btn.Primary}"
                    Height="34" MinWidth="150" Margin="8,0,0,0"
                    IsDefault="True"
                    Click="AlGuardar"/>
        </StackPanel>
    </Grid>
</Window>
