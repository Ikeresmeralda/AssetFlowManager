<Window x:Class="AssetFlow.Desktop.Dialogs.NotaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        DECISIÓN CON NOTA
        =================
        Confirma una acción y recoge de paso el motivo, en un solo paso.

        Antes esto eran dos ventanas seguidas: primero se pedía el motivo y
        después se confirmaba. Dos diálogos encadenados para una sola decisión
        se leen como un error de la aplicación, y el segundo se acepta sin
        mirar.
    -->

    <Border Background="{StaticResource Surface}"
            CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,24,24,20">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="IconoFondo" Width="34" Height="34" CornerRadius="17"
                            Background="{StaticResource AccentSoft}"
                            VerticalAlignment="Top">
                        <TextBlock x:Name="Icono" Text="{StaticResource Ico.Info}"
                                   Style="{StaticResource Icon}"
                                   Foreground="{StaticResource Accent}"/>
                    </Border>

                    <TextBlock x:Name="Titulo" Text=""
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource T.Subtitle}"
                               TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>

                <TextBlock x:Name="Mensaje" Text=""
                           Margin="48,10,0,0"
                           TextWrapping="Wrap"
                           Style="{StaticResource T.Muted}"
                           LineHeight="19"/>

                <StackPanel Margin="48,16,0,0">
                    <!-- El campo lleva etiqueta propia, no sólo texto de
                         marcador: el marcador desaparece al escribir y quien
                         usa un lector de pantalla se queda sin saber qué
                         estaba rellenando. -->
                    <TextBlock x:Name="EtiquetaNota" Text="Motivo"
                               Style="{StaticResource T.Label}"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="TxtNota"
                             Height="66"
                             Padding="10,8,10,8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="AlEscribir"/>

                    <TextBlock x:Name="TxtRestantes" Text=""
                               Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource TextSubtle}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6" Padding="20,14,20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelar" Content="Cancelar"
                            MinWidth="96"
                            Style="{StaticResource Btn.Secondary}"
                            IsCancel="True"
                            Click="AlCancelar"/>
                    <Button x:Name="BtnConfirmar" Content="Continuar"
                            MinWidth="112" Margin="8,0,0,0"
                            Style="{StaticResource Btn.Primary}"
                            Click="AlConfirmar"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
