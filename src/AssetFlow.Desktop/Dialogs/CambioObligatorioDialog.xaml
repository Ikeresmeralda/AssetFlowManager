<Window x:Class="AssetFlow.Desktop.Dialogs.CambioObligatorioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elige tu contraseña"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        CAMBIO OBLIGATORIO DE CONTRASEÑA
        ================================
        Se abre nada más entrar con una contraseña provisional, y no se puede
        cerrar sin cambiarla: el único botón de salida cierra la sesión.

        Por qué es obligatorio: la contraseña provisional es «usuario + 123@»,
        deducible por cualquiera que vea el nombre de usuario. Eso solo es
        aceptable porque caduca en el primer uso. Si esta ventana se pudiera
        saltar, esa contraseña sería permanente y la cuenta quedaría abierta.

        Que esta ventana no se pueda cerrar es comodidad de interfaz, no la
        medida de seguridad: quien ignore el cliente y llame a la API se
        encuentra un 403 en todo lo demás hasta que cambie la contraseña.
    -->

    <Border Background="{StaticResource Surface}"
            CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== CABECERA ==================== -->
            <StackPanel Grid.Row="0" Margin="24,24,24,0" Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17"
                        Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock Text="{StaticResource Ico.Key}"
                               Style="{StaticResource Icon}"
                               Foreground="{StaticResource Accent}"/>
                </Border>

                <StackPanel Margin="14,0,0,0" MaxWidth="360">
                    <TextBlock Text="Elige tu contraseña"
                               Style="{StaticResource T.Subtitle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Subtitulo"
                               Text="Estás usando una contraseña provisional. Elige una propia para continuar."
                               Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                               Margin="0,4,0,0" LineHeight="19"/>
                </StackPanel>
            </StackPanel>

            <!-- ==================== CUERPO ==================== -->
            <StackPanel Grid.Row="1" Margin="72,16,24,20">

                <TextBlock x:Name="LblActual" Text="Contraseña provisional"
                           Style="{StaticResource T.Label}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtActual" Height="38"
                             MaxLength="128"
                             PasswordChanged="AlEscribir"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblActual}"/>

                <TextBlock x:Name="LblClave" Text="Contraseña nueva"
                           Style="{StaticResource T.Label}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="TxtClave" Height="38"
                             MaxLength="128"
                             PasswordChanged="AlEscribir"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblClave}"/>

                <TextBlock x:Name="LblRepetir" Text="Repite la contraseña"
                           Style="{StaticResource T.Label}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="TxtRepetir" Height="38"
                             MaxLength="128"
                             PasswordChanged="AlEscribir"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblRepetir}"/>

                <TextBlock Text="Mínimo 10 caracteres, y distinta de la provisional. Al cambiarla se cerrarán las demás sesiones de tu cuenta."
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource TextSubtle}"
                           TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="16"/>

                <Border x:Name="PanelError" Style="{StaticResource Badge.Danger}"
                        Visibility="Collapsed" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Padding="12,9,12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Ico.Error}"
                                   Style="{StaticResource Icon.Small}" FontSize="12"
                                   Foreground="{StaticResource Danger}"
                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtError" Text=""
                                   Style="{StaticResource T.Caption}"
                                   Foreground="{StaticResource Danger}"
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== PIE ==================== -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6" Padding="20,14,20,14">
                <Grid>
                    <!-- No hay "Cancelar": la única salida sin cambiarla es
                         cerrar sesión, porque la cuenta no puede hacer nada
                         más hasta entonces. -->
                    <Button x:Name="BtnSalir" Content="Cerrar sesión"
                            HorizontalAlignment="Left"
                            Style="{StaticResource Btn.Ghost}"
                            Click="AlCerrarSesion"/>

                    <Button x:Name="BtnAccion" Content="Guardar contraseña"
                            HorizontalAlignment="Right"
                            MinWidth="150"
                            Style="{StaticResource Btn.Primary}"
                            IsDefault="True"
                            Click="AlAceptar"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
