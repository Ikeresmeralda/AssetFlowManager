<Window x:Class="AssetFlow.Desktop.Dialogs.RecuperacionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar contraseña"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        RECUPERACIÓN DE CONTRASEÑA
        ==========================
        Un solo paso: se deja la solicitud y la resuelve un administrador desde
        dentro de la aplicación.

        Por qué no un código por correo: el correo es un canal que este proyecto
        no controla y que en la práctica falla (dominio sin verificar, filtros de
        no deseado). Aquí la autorización la da una persona, que además puede
        comprobar por otra vía que quien pide el cambio es quien dice ser.

        Lo que la ventana NO hace, y es deliberado: no dice si el correo existe.
        El servidor responde siempre lo mismo y esta pantalla se limita a
        repetirlo. Distinguir los casos aquí —un mensaje distinto, un tiempo de
        espera distinto— reintroduciría por el cliente la enumeración de cuentas
        que el servidor evita.
    -->

    <Border Background="{StaticResource Surface}"
            CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== CABECERA ==================== -->
            <StackPanel Grid.Row="0" Margin="24,24,24,0" Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17"
                        Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                    <TextBlock Text="{StaticResource Ico.Key}"
                               Style="{StaticResource Icon}"
                               Foreground="{StaticResource Accent}"/>
                </Border>

                <StackPanel Margin="14,0,0,0" MaxWidth="360">
                    <TextBlock x:Name="Titulo" Text="Recuperar contraseña"
                               Style="{StaticResource T.Subtitle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Subtitulo"
                               Text="Un administrador recibirá tu solicitud y te dará una contraseña provisional."
                               Style="{StaticResource T.Muted}" TextWrapping="Wrap"
                               Margin="0,4,0,0" LineHeight="19"/>
                </StackPanel>
            </StackPanel>

            <!-- ==================== CUERPO ==================== -->
            <StackPanel Grid.Row="1" Margin="72,16,24,20">

                <TextBlock x:Name="LblCorreo" Text="Correo de tu cuenta"
                           Style="{StaticResource T.Label}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCorreo" Height="38"
                         Tag="nombre@ejemplo.com"
                         MaxLength="255"
                         TextChanged="AlEscribir"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblCorreo}"/>

                <TextBlock Text="Cuando la aprueben, entrarás con una contraseña provisional y la aplicación te pedirá que elijas una definitiva."
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource TextSubtle}"
                           TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="16"/>

                <!-- Mensajes. El aviso informativo y el de error son cajas
                     distintas: uno confirma que el paso ha ido bien y el otro
                     dice que hay que corregir algo. -->
                <Border x:Name="PanelInfo" Style="{StaticResource Badge.Info}"
                        Visibility="Collapsed" Margin="0,16,0,0"
                        HorizontalAlignment="Stretch" Padding="12,9,12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Ico.Mail}"
                                   Style="{StaticResource Icon.Small}" FontSize="12"
                                   Foreground="{StaticResource Accent}"
                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtInfo" Text=""
                                   Style="{StaticResource T.Caption}"
                                   Foreground="{StaticResource Accent}"
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>

                <Border x:Name="PanelError" Style="{StaticResource Badge.Danger}"
                        Visibility="Collapsed" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Padding="12,9,12,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Ico.Error}"
                                   Style="{StaticResource Icon.Small}" FontSize="12"
                                   Foreground="{StaticResource Danger}"
                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtError" Text=""
                                   Style="{StaticResource T.Caption}"
                                   Foreground="{StaticResource Danger}"
                                   TextWrapping="Wrap" MaxWidth="300"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== PIE ==================== -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6" Padding="20,14,20,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelar" Content="Cancelar"
                            MinWidth="96"
                            Style="{StaticResource Btn.Secondary}"
                            IsCancel="True"
                            Click="AlCancelar"/>
                    <Button x:Name="BtnAccion" Content="Enviar solicitud"
                            MinWidth="132" Margin="8,0,0,0"
                            Style="{StaticResource Btn.Primary}"
                            IsDefault="True"
                            Click="AlAceptar"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
