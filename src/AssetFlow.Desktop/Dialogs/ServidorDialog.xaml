<Window x:Class="AssetFlow.Desktop.Dialogs.ServidorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource Surface}"
            CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,22,24,20">
                <TextBlock Text="Servidor" Style="{StaticResource T.Subtitle}"/>
                <TextBlock Text="Dirección del servicio de inventario al que se conecta la aplicación."
                           Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Dirección" Style="{StaticResource T.Label}" Margin="0,20,0,5"/>
                <TextBox x:Name="TxtDireccion" Height="36"
                         Tag="http://localhost:5171/"
                         FontFamily="{StaticResource FontMono}" FontSize="12"
                         TextChanged="AlEscribir"/>

                <TextBlock Text="Si no incluyes la barra final se añadirá automáticamente."
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource TextSubtle}"
                           Margin="0,6,0,0"/>

                <!-- Resultado de la comprobacion -->
                <Border x:Name="PanelResultado" Visibility="Collapsed"
                        Margin="0,16,0,0" HorizontalAlignment="Stretch"
                        Padding="12,9,12,9"
                        Style="{StaticResource Badge.Neutral}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="IcoResultado" Text=""
                                   Style="{StaticResource Icon.Small}" FontSize="12"
                                   Margin="0,0,9,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtResultado" Text=""
                                   Style="{StaticResource T.Caption}"
                                   TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6" Padding="20,14,20,14">
                <Grid>
                    <Button x:Name="BtnProbar" Content="Probar conexión"
                            HorizontalAlignment="Left" MinWidth="130"
                            Style="{StaticResource Btn.Secondary}"
                            Click="AlProbar"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" MinWidth="96"
                                Style="{StaticResource Btn.Secondary}"
                                IsCancel="True" Click="AlCancelar"/>
                        <Button x:Name="BtnGuardar" Content="Guardar" MinWidth="104"
                                Margin="8,0,0,0"
                                Style="{StaticResource Btn.Primary}"
                                IsDefault="True" Click="AlGuardar"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
