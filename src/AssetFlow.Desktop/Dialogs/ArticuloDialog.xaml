<Window x:Class="AssetFlow.Desktop.Dialogs.ArticuloDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        FORMULARIO DE ARTICULO
        ======================
        Una sola columna. Los formularios a dos columnas obligan a la vista a
        zigzaguear y se leen peor; con seis campos no hay ningun motivo para
        complicarlo.

        Cada campo lleva su etiqueta encima (no al lado): el ojo baja en linea
        recta y funciona igual cuando los textos se alargan al traducir.

        La validacion se muestra bajo el campo afectado, no en una ventana
        aparte: el error se ve junto a lo que hay que corregir.
    -->

    <Border Background="{StaticResource Surface}"
            CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270"
                              Color="#000000" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Grid Grid.Row="0" Margin="24,20,16,0">
                <StackPanel>
                    <TextBlock x:Name="Titulo" Text="Nuevo artículo"
                               Style="{StaticResource T.Subtitle}"/>
                    <TextBlock x:Name="Subtitulo" Text="Añade un artículo al inventario"
                               Style="{StaticResource T.Caption}" Margin="0,2,0,0"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="30" Height="30" Padding="0"
                        Style="{StaticResource Btn.Ghost}"
                        ToolTip="Cerrar (Esc)"
                        IsCancel="True" Click="AlCancelar">
                    <TextBlock Text="{StaticResource Ico.Close}" Style="{StaticResource Icon.Small}"/>
                </Button>
            </Grid>

            <!-- Campos -->
            <StackPanel Grid.Row="1" Margin="24,18,24,20">

                <TextBlock Text="Nombre del artículo" Style="{StaticResource T.Label}"/>
                <TextBox x:Name="TxtNombre" MaxLength="120"
                         Tag="Ej.: Taladro percutor 750 W"
                         TextChanged="AlEditarCampo"/>
                <TextBlock x:Name="ErrNombre" Visibility="Collapsed"
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Danger}"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Tipo o categoría" Style="{StaticResource T.Label}" Margin="0,14,0,5"/>
                <TextBox x:Name="TxtTipo" MaxLength="80"
                         Tag="Ej.: Herramienta eléctrica"
                         TextChanged="AlEditarCampo"/>
                <TextBlock x:Name="ErrTipo" Visibility="Collapsed"
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Danger}"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Editor o proveedor" Style="{StaticResource T.Label}" Margin="0,14,0,5"/>
                <TextBox x:Name="TxtProveedor" MaxLength="120"
                         Tag="Opcional"/>

                <TextBlock Text="Unidades en stock" Style="{StaticResource T.Label}" Margin="0,14,0,5"/>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Los botones evitan tener que seleccionar y teclear para
                         ajustes de una o dos unidades, que es el caso habitual. -->
                    <Button Grid.Column="0" Content="−" Width="32"
                            Style="{StaticResource Btn.Secondary}"
                            FontSize="16" Padding="0"
                            Click="AlRestarUnidad"/>
                    <TextBox x:Name="TxtStock" Grid.Column="1" Width="82"
                             Text="0" MaxLength="7"
                             TextAlignment="Center"
                             FontFamily="{StaticResource FontMono}"
                             Margin="6,0,6,0"
                             PreviewTextInput="SoloNumeros"
                             TextChanged="AlEditarCampo"/>
                    <Button Grid.Column="2" Content="+" Width="32"
                            Style="{StaticResource Btn.Secondary}"
                            FontSize="15" Padding="0"
                            Click="AlSumarUnidad"/>
                </Grid>
                <TextBlock x:Name="ErrStock" Visibility="Collapsed"
                           Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Danger}"
                           Margin="0,4,0,0"/>

                <!-- Aviso contextual de stock: informa sin bloquear. -->
                <Border x:Name="AvisoStock" Style="{StaticResource Badge.Warning}"
                        Visibility="Collapsed" Margin="0,12,0,0"
                        HorizontalAlignment="Stretch" Padding="10,7,10,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Ico.Warning}"
                                   Style="{StaticResource Icon.Small}" FontSize="12"
                                   Foreground="{StaticResource Warning}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtAvisoStock" Text=""
                                   Style="{StaticResource T.Caption}"
                                   Foreground="{StaticResource Warning}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Acciones -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6" Padding="20,14,20,14">
                <Grid>
                    <TextBlock x:Name="TxtCodigo" Text=""
                               VerticalAlignment="Center"
                               Style="{StaticResource T.Caption}"
                               Foreground="{StaticResource TextSubtle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" MinWidth="96"
                                Style="{StaticResource Btn.Secondary}"
                                IsCancel="True" Click="AlCancelar"/>
                        <Button x:Name="BtnGuardar" Content="Guardar" MinWidth="112"
                                Margin="8,0,0,0"
                                Style="{StaticResource Btn.Primary}"
                                IsDefault="True" Click="AlGuardar"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
